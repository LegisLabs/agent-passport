# pay.cdir.legislabs.uk — Agent Passport, payments vertical (C:\>DIR hackathon).
# Drop-in for the shared Caddy owned by the Compass deploy. Public, no login (judges and voters open it directly).
pay.cdir.legislabs.uk {
	encode gzip zstd
	header X-Robots-Tag "noindex"
	reverse_proxy cdir-pay:8014
}
