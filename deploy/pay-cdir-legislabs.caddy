# pay.cdir.legislabs.uk — Agent Passport, payments vertical (C:\>DIR hackathon).
# Drop-in for the shared Caddy owned by the Compass deploy. Same basic-auth gate as the HMRC app.
# publish.sh substitutes __PASSWORD_HASH__.
pay.cdir.legislabs.uk {
	encode gzip zstd
	header X-Robots-Tag "noindex"
	basic_auth {
		lexis __PASSWORD_HASH__
	}
	reverse_proxy cdir-pay:8014
}
