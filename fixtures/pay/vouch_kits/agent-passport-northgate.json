     "effect": "deny", "failureBehavior": "block"}
  ],
  "violationScript": [
    {"id": "compliant-fenwick", "label": "Agent 247 pays Fenwick Timber within the mandate", "violationType": null, "kind": "payment", "actorRef": "agent-247", "merchantRef": "fenwick",
