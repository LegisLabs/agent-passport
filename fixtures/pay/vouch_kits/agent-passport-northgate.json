    "eligibilityRules": [{"fieldKey": "agentRole", "operator": "equals", "value": "accounts-payable-agent", "tierAssigned": 1, "priority": 1}],
    "categories": [{"code": "SUPPLIES", "label": "Supplier invoices"}]
