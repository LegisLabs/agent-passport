GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# gemini | fixture
EXTRACTION_MODE=gemini

# vouch.finance hackathon sandbox: Developer Portal > Hackathon > Create hackathon key (sk_test_, shown once)
HACKATHON_ORG_API_KEY=
API_BASE_URL=https://cdir.vouch.finance/api/v1
# vouch adapter: fixture (default, no network) | live (sandbox, falls back to fixture visibly)
VOUCH_MODE=fixture
# local (bank executes) | vouch (also settle each ALLOW on the vouch rail; needs VOUCH_PROGRAM_ID, VOUCH_MERCHANT_ID, VOUCH_PRIVY_USER_ID)
PAYMENT_RAIL=local
VOUCH_PROGRAM_ID=
VOUCH_PRIVY_USER_ID=
VOUCH_MERCHANTS={}
VOUCH_CATEGORY=SUPPLIES

# Companies House Public Data API (free key from https://developer.company-information.service.gov.uk). Without it the app
# answers payee and provider checks from the synthetic demo register and says so.
COMPANIES_HOUSE_API_KEY=
